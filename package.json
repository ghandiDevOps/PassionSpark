{
  "name": "passionplay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "npx ts-node --project tsconfig.seed.json prisma/seed.ts",
    "db:seed:dev": "npx ts-node --project tsconfig.seed.json prisma/seed-dev.ts",
    "db:seed:dev:reset": "npx ts-node --project tsconfig.seed.json prisma/seed-dev.ts --reset",
    "db:generate": "prisma generate",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:full": "node scripts/screenshot.mjs --full",
    "design:check": "node scripts/screenshot.mjs && echo '\\n→ Envoie les images screenshots/ à Claude pour review'"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.1.0",
    "@hookform/resolvers": "^3.4.2",
    "@prisma/client": "^5.13.0",
    "@react-email/components": "^0.0.18",
    "@sentry/nextjs": "^8.6.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.88",
    "@stripe/react-stripe-js": "^2.7.1",
    "@stripe/stripe-js": "^3.4.0",
    "@supabase/supabase-js": "^2.43.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "14.2.3",
    "next-themes": "^0.4.6",
    "qrcode.react": "^3.1.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.51.4",
    "recharts": "^3.8.1",
    "resend": "^3.2.0",
    "sonner": "^1.7.4",
    "stripe": "^15.7.0",
    "svix": "^1.90.0",
    "tailwind-merge": "^2.6.1",
